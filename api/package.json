{
    "name": "invoice-api",
    "version": "0.1.0",
    "private": true,
    "scripts": {
        "dev": "ts-node-dev --transpile-only --respawn src/index.ts",
        "build": "tsc -p .",
        "start": "node dist/index.js",
        "typeorm:run": "ts-node ./node_modules/typeorm/cli.js migration:run -d ./src/data-source.ts",
        "typeorm:revert": "ts-node ./node_modules/typeorm/cli.js migration:revert -d ./src/data-source.ts",
        "lint": "eslint 'src/**/*.ts'"
    },
    "dependencies": {
        "bcryptjs": "^2.4.3",
        "class-transformer": "^0.5.1",
        "class-validator": "^0.14.2",
        "dotenv": "^16.1.4",
        "express": "^4.18.2",
        "jsonwebtoken": "^9.0.0",
        "pg": "^8.9.0",
        "reflect-metadata": "^0.1.13",
        "typeorm": "^0.3.17"
    },
    "devDependencies": {
        "@types/cors": "^2.8.19",
        "@types/express": "^4.17.17",
        "@types/jsonwebtoken": "^9.0.10",
        "@types/node": "^20.0.0",
        "@typescript-eslint/eslint-plugin": "^6.4.0",
        "@typescript-eslint/parser": "^6.4.0",
        "cors": "^2.8.5",
        "eslint": "^8.40.0",
        "install": "^0.13.0",
        "npm": "^11.6.2",
        "ts-node": "^10.9.1",
        "ts-node-dev": "^2.0.0",
        "typescript": "^5.0.4"
    }
}
